# Maintainer: Tims <[EMAIL_ADDRESS]>
pkgname=lumalens
pkgver=0.1.0
pkgrel=1
pkgdesc='GTK4/Libadwaita camera app with live filters and virtual camera output'
arch=('x86_64')
url='https://github.com/TimsTittus/lumalens'
license=('GPL-3.0-or-later')
depends=(
    'gtk4'
    'libadwaita'
    'gstreamer'
    'gst-plugins-base'
    'gst-plugins-good'
    'gst-plugins-bad'
    'gst-libav'
)
optdepends=(
    'v4l2loopback-dkms: for virtual camera output'
    'v4l-utils: for debugging camera devices'
)
makedepends=('cargo' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')
install=lumalens.install

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --release --frozen --workspace
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/lumalens "$pkgdir/usr/bin/lumalens"
    install -Dm644 data/io.github.timstittus.lumalens.desktop \
        "$pkgdir/usr/share/applications/io.github.timstittus.lumalens.desktop"
    install -Dm644 data/io.github.timstittus.lumalens.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.timstittus.lumalens.svg"
}
