<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.timstittus.lumalens</id>

  <name>LumaLens</name>
  <summary>Webcam customization studio</summary>

  <description>
    <p>
      LumaLens is a webcam customization application built with GTK4 and
      GStreamer. It lets you tune brightness, contrast, saturation, and
      orientation in real time, save your favourite looks as named presets,
      and pipe the result to a virtual camera device so other applications
      see your adjusted feed.
    </p>
    <p>Features:</p>
    <ul>
      <li>Live camera preview with hardware-accelerated GStreamer pipeline</li>
      <li>Multi-camera support with hot-plug detection</li>
      <li>Brightness, contrast, and saturation sliders</li>
      <li>Mirror and rotation controls</li>
      <li>Runtime resolution and frame-rate switching</li>
      <li>Named image presets with three built-in defaults</li>
      <li>Virtual camera output via v4l2loopback</li>
      <li>Persistent configuration across sessions</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.timstittus.lumalens.desktop</launchable>

